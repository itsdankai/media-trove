# Free key: themoviedb.org > Settings > API. Either the v3 "API Key" or the v4 "Read Access Token" works.
TMDB_API_KEY=

# The address people use to reach MediaTrove, e.g. https://mediatrove.example.com
# (needed behind a reverse proxy for email links and Google/OIDC sign-in).
MEDIATROVE_URL=

# Who can make an account: invite (default), open or closed. The first account (the admin) can always be made.
MEDIATROVE_SIGNUPS=invite

# Optional: posters with IMDb / Rotten Tomatoes scores on them (ratingposterdb.com). Turn off in Settings.
RPDB_API_KEY=

# Audible store region for audiobook search: us, uk, ca, au, de, fr, it, es, in, jp
AUDIBLE_REGION=us

# Optional. The Simkl import's app client ID (free at simkl.com/settings/developer).
SIMKL_CLIENT_ID=

# Optional. Email (invites, password resets) through Resend (resend.com, free tier). The sender must be
# on a domain you've verified with Resend, e.g. MediaTrove <mediatrove@example.com>
RESEND_API_KEY=
MEDIATROVE_EMAIL_FROM=
# Also email the admin's weekly backup here.
MEDIATROVE_BACKUP_EMAIL_TO=

# Optional. "Continue with Google": an OAuth client from console.cloud.google.com,
# redirect address <MEDIATROVE_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. A button for your own login server (Authentik, Pocket ID, Keycloak...),
# redirect address <MEDIATROVE_URL>/api/auth/callback/oidc
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=

# From before accounts: if set, asked for until the first account exists, then unused.
MEDIATROVE_PASSWORD=
