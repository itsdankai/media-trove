# Free key: themoviedb.org > Settings > API. Either the v3 "API Key" or the v4 "Read Access Token" works.
TMDB_API_KEY=

# Set this whenever anyone but you can reach MediaTrove. The browser asks for it (any username works).
MEDIATROVE_PASSWORD=

# Audible store region for audiobook search: us, uk, ca, au, de, fr, it, es, in, jp
AUDIBLE_REGION=us

# Optional. The Simkl import's app client ID (free at simkl.com/settings/developer).
SIMKL_CLIENT_ID=

# Optional. Email the weekly backup through Resend (resend.com, free tier). All three are needed;
# the sender must be on a domain you've verified with Resend, e.g. MediaTrove <backups@example.com>
RESEND_API_KEY=
MEDIATROVE_BACKUP_EMAIL_TO=
MEDIATROVE_BACKUP_EMAIL_FROM=
